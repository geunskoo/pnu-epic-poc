---
import Layout from '../layouts/Layout.astro';

const sections = [
	{ title: '연구실 소개', body: 'GSAP 스크롤 리빌 애니메이션 검증용 더미 섹션입니다.' },
	{ title: '연구 분야', body: '스크롤을 내리면 순서대로 나타나야 합니다.' },
	{ title: '공지사항', body: '페이지 전환(홈 ↔ 논문 목록) 후에도 정상 동작해야 합니다.' },
];
---

<Layout title="pnu-epic POC — 홈">
	<h1>pnu-epic POC</h1>
	<p>GSAP ScrollTrigger 리빌 애니메이션 검증 페이지</p>
	{
		sections.map((s) => (
			<section data-reveal style="margin: 4rem 0; padding: 2rem; background: #f2f2f2;">
				<h2>{s.title}</h2>
				<p>{s.body}</p>
			</section>
		))
	}
</Layout>

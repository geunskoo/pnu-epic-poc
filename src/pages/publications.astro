---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const publications = (await getCollection('publications')).sort(
	(a, b) => b.data.year - a.data.year
);
---

<Layout title="논문 목록 (POC)">
	<h1>논문 목록 (POC — Content Collections 검증용 더미 데이터)</h1>
	{
		publications.map((pub) => (
			<article data-reveal style="margin: 3rem 0; padding: 1.5rem; background: #f2f2f2;">
				<strong>{pub.data.title}</strong> ({pub.data.year})<br />
				{pub.data.authors.join(', ')} — {pub.data.journal}
				{pub.data.link && (
					<>
						{' '}
						<a href={pub.data.link}>link</a>
					</>
				)}
			</article>
		))
	}
</Layout>

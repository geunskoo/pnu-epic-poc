---
import '@fontsource/noto-serif-kr/700.css';
import '@fontsource/ibm-plex-sans-kr/400.css';
import '@fontsource/ibm-plex-sans-kr/500.css';
import '@fontsource/ibm-plex-sans-kr/600.css';
import '../styles/design-a-tokens.css';

interface Props {
	title: string;
}
const { title } = Astro.props;
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title} — Design A</title>
	</head>
	<body>
		<header
			style="border-bottom: 1px solid var(--color-border); padding: 1.5rem 2rem;"
		>
			<nav style="display:flex; gap:2rem; max-width: 960px; margin: 0 auto; align-items: baseline;">
				<a href="/pnu-epic-poc/design-a/" style="font-family: var(--font-heading); font-size: 1.15rem; font-weight: 700; text-decoration: none;">EPIC Lab</a>
				<a href="/pnu-epic-poc/design-a/publications/" style="text-decoration: none; color: var(--color-ink-muted); font-size: 0.9rem;">논문 목록</a>
				<span style="margin-left:auto; font-size: 0.8rem; color: var(--color-ink-muted);">Design A — 보수적</span>
			</nav>
		</header>
		<main style="max-width: 960px; margin: 0 auto; padding: 0 2rem;">
			<slot />
		</main>
		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';
			gsap.registerPlugin(ScrollTrigger);

			function setupReveals() {
				gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
					gsap.fromTo(
						el,
						{ autoAlpha: 0, y: 16 },
						{
							autoAlpha: 1,
							y: 0,
							duration: 0.5,
							ease: 'power1.out',
							scrollTrigger: { trigger: el, start: 'top 88%' },
						}
					);
				});
			}
			document.addEventListener('astro:page-load', setupReveals);
			document.addEventListener('astro:before-swap', () => {
				ScrollTrigger.getAll().forEach((t) => t.kill());
			});
		</script>
	</body>
</html>
